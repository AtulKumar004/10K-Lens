# Copy this file to .env and change the passwords. Never commit .env.
# Passwords: unique per service, URL-safe (letters, digits, - and _), e.g. from
#   uv run python -c "import secrets; print(secrets.token_urlsafe(24))"
# Changing a password here does not change the service; update it there too.

# Postgres (app role, not the postgres superuser; apply with ALTER ROLE ... PASSWORD)
POSTGRES_USER=secrag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=secrag
POSTGRES_PORT=5432

# Qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# Redis (must match requirepass in /etc/redis/redis.conf inside WSL)
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# Ollama (runs natively on Windows)
OLLAMA_BASE_URL=http://localhost:11434

# SEC EDGAR (used from F1): your name and a real contact email
SEC_USER_AGENT="Your Name your-email@example.com"